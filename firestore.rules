rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidEmail(email) {
      return email is string && email.size() >= 5 && email.size() <= 180 && email.matches('^.+@.+\\..+$');
    }

    function isValidAcudiente(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 150 &&
             data.tipoDocumento is string && data.tipoDocumento.size() > 0 && data.tipoDocumento.size() <= 20 &&
             data.numeroDocumento is string && data.numeroDocumento.size() > 0 && data.numeroDocumento.size() <= 40 &&
             isValidEmail(data.correo) &&
             data.codigoVerificacion is string && data.codigoVerificacion.size() > 0 && data.codigoVerificacion.size() <= 30;
    }

    function isValidAdministrativo(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 150 &&
             data.tipoDocumento is string && data.tipoDocumento.size() > 0 && data.tipoDocumento.size() <= 20 &&
             data.numeroDocumento is string && data.numeroDocumento.size() > 0 && data.numeroDocumento.size() <= 40 &&
             isValidEmail(data.correo) &&
             data.codigoVerificacion is string && data.codigoVerificacion.size() > 0 && data.codigoVerificacion.size() <= 30;
    }

    function isValidEstudiante(data) {
      return data.nombre is string && data.nombre.size() > 0 && data.nombre.size() <= 150 &&
             data.tipoDocumento is string && data.tipoDocumento.size() > 0 && data.tipoDocumento.size() <= 20 &&
             data.numeroDocumento is string && data.numeroDocumento.size() > 0 && data.numeroDocumento.size() <= 40 &&
             isValidEmail(data.correo);
    }

    match /acudientes/{docId} {
      allow read: if true;
      allow create, update: if isValidAcudiente(request.resource.data);
      allow delete: if request.auth != null;
    }

    match /guardians/{docId} {
      allow read: if true;
      allow create, update: if isValidAcudiente(request.resource.data);
      allow delete: if request.auth != null;
    }

    match /administrativos/{docId} {
      allow read: if true;
      allow create, update: if isValidAdministrativo(request.resource.data);
      allow delete: if request.auth != null;
    }

    match /admins/{docId} {
      allow read: if true;
      allow create, update: if isValidAdministrativo(request.resource.data);
      allow delete: if request.auth != null;
    }

    match /estudiantes/{docId} {
      allow read: if true;
      allow create, update: if isValidEstudiante(request.resource.data);
      allow delete: if request.auth != null;
    }

    match /students/{docId} {
      allow read: if true;
      allow create, update: if isValidEstudiante(request.resource.data);
      allow delete: if request.auth != null;
    }

    match /users/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.email is string && request.resource.data.name is string;
      allow delete: if request.auth != null;
    }

    match /matriculas/{enrollmentId} {
      allow read, create, update: if true;
      allow delete: if request.auth != null;
    }
  }
}

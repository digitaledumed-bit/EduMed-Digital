# Configuración General
VITE_APP_NAME="EduMed Digital"
PORT=3000

# Configuración del Servicio de Correo Electrónico para Recuperación de Contraseñas
# Si no se definen credenciales personalizadas, el servidor utiliza el transporte de prueba SMTP (Ethereal) para envíos seguros.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=notificaciones@edumed.edu.co
SMTP_PASS=tu_clave_de_aplicacion_o_token
SMTP_FROM="EduMed Digital <no-reply@edumed.edu.co>"
APP_URL=http://localhost:3000
